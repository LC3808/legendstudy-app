+'use client';
+import {useEffect,useRef,useState} from 'react';
+import type {SupabaseClient} from '@supabase/supabase-js';
+import '../admin/admin-analytics.css';
+import {QlStructuredValue,QlSection} from './quality-primitives';
+type Row={run_id:string;question_id:string;official_label:string|null;state:string;created_at:string;reviewed:boolean;parent_id:string|null};
+type Subject=Row&{snapshot_sha256:string;answer:unknown;result:unknown;result_available:boolean};
+type Review={id:string;is_active:boolean;overall_disposition:string;created_at:string;summary_note:string|null;review_evidence:unknown};
+type Detail={subject:Subject;history:Review[]};
+const dimensions={diagnosis:'진단의 정확성',core_priority:'핵심 문제의 우선순위',actionability:'개선 조언의 실행 가능성',evidence_adherence:'당시 근거 준수',stance_preservation:'학생 논지 보존',hallucination_absence:'없는 내용·오류 생성 없음'};
+export function ExamQuality({client}:{client:SupabaseClient}){
+ const [period,setPeriod]=useState(30),[offset,setOffset]=useState(0),[unreviewed,setUnreviewed]=useState(false),[reload,setReload]=useState(0);
+ const [list,setList]=useState<{rows:Row[];total:number;coverage:{subjects:number;reviewed:number}}|null>(null),[detail,setDetail]=useState<Detail|null>(null),[error,setError]=useState('');
+ const [loading,setLoading]=useState(true);const request=useRef(0);
+ useEffect(()=>{let live=true;const requests=request;const to=new Date();const from=new Date(to.getTime()-period*86400000);void client.rpc('ql_exam_cases',{p_from:from.toISOString(),p_to:to.toISOString(),p_offset:offset,p_unreviewed:unreviewed}).then(({data,error})=>{if(!live)return;if(error){setError('목록 조회 실패: 권한·RPC 연결 상태를 확인하세요.');setList(null);}else{setList(data);setError('');}setLoading(false);});return()=>{live=false;requests.current++;};},[client,period,offset,unreviewed,reload]);
