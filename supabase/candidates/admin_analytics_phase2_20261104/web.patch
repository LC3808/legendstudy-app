+ function refresh(){request.current++;setDetail(null);setList(null);setLoading(true);setReload(x=>x+1);}
+ return <main className="content-wrap content-wrap--wide"><h1>회차·혼합형 품질 검수</h1><p>저장된 원본을 검토합니다. 사람 검토는 학생 결과·이용권에 영향을 주지 않습니다.</p>
+ <div className="analytics-filter"><label>요청 기간<select value={period} onChange={e=>{setPeriod(Number(e.target.value));setOffset(0);refresh();}}><option value={7}>최근 7일</option><option value={30}>최근 30일</option><option value={400}>최근 400일</option></select></label><label><input type="checkbox" checked={unreviewed} onChange={e=>{setUnreviewed(e.target.checked);setOffset(0);refresh();}}/>미검토만</label><button onClick={refresh}>새로고침</button></div>
+ {error&&<p role="alert">{error}</p>}{loading&&<p role="status">목록 조회 중…</p>}
+ {list&&<><p>회차 내 문항 {list.coverage.subjects}건 · 검토 기록 보유 {list.coverage.reviewed}건 · 현재 조건 {list.total}건. 처리 완료는 품질 통과를 뜻하지 않습니다.</p><div className="analytics-table"><table><caption>원본 회차·문항별 검토 후보</caption><thead><tr><th>공식 문항</th><th>요청일 (KST)</th><th>회차</th><th>처리 상태</th><th>검토</th></tr></thead><tbody>{list.rows.map(r=><tr key={r.run_id+r.question_id}><td>{r.official_label??'공식 번호 미확인'}</td><td>{new Date(r.created_at).toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})}</td><td>{r.parent_id?'재첨삭':'최초/후속 유료'}</td><td>{r.state}</td><td><button onClick={()=>void select(r)}>{r.reviewed?'검토 이력':'검토 시작'}</button></td></tr>)}</tbody></table></div>{!list.rows.length&&<p>조건에 맞는 기록이 없습니다.</p>}<button disabled={!offset} onClick={()=>{setOffset(Math.max(0,offset-50));refresh();}}>이전</button> <span>{offset+1}–{offset+list.rows.length} / {list.total}</span> <button disabled={offset+50>=list.total} onClick={()=>{setOffset(offset+50);refresh();}}>다음</button></>}
