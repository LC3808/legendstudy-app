+'use client';
+import {useEffect,useMemo,useState} from 'react';
+import Link from 'next/link';
+import {useAuth} from '@/components/auth-context';
+import {analyticsWindow} from '@/lib/admin/analytics';
+import './admin-analytics.css';
+import {AdminPanel} from './admin-surface';
+type Report={state:string;formula_version:string;as_of:string;metrics:Record<string,number>|null;weekly_state:string;weekly:{week:string;users:number;partial:boolean}[];exams_state:string;exams:{exam_id:string;exam_name:string;university:string;users:number;runs:number;questions:number}[]};
+export function AdminLearningHub(){
+ const {client,user}=useAuth();const [now,setNow]=useState(()=>new Date());const [period,setPeriod]=useState<'d7'|'d30'>('d30');const range=useMemo(()=>analyticsWindow(period,'','',now)!,[period,now]);const key=JSON.stringify([user?.id,range,now]);
+ const [result,setResult]=useState<{key:string;data?:Report;error?:boolean}|null>(null);
+ useEffect(()=>{let active=true;if(!client||!user)return;void client.rpc('admin_exam_learning',range).then(({data,error})=>{if(active)setResult(error?{key,error:true}:{key,data});});return()=>{active=false;};},[client,user,range,key]);const data=result?.key===key?result.data:undefined;
+ return <div className="admin-stack"><form className="analytics-filter" onSubmit={e=>{e.preventDefault();setNow(new Date());}}><label>기간 (KST)<select value={period} onChange={e=>setPeriod(e.target.value as 'd7'|'d30')}><option value="d7">최근 7일</option><option value="d30">최근 30일</option></select></label><button>새로고침</button></form>
