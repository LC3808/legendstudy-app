        "conname": "essay_exams_official_evidence",
        "definition": "CHECK (((verification_status <> 'verified'::text) OR (provenance <> 'official'::text) OR (official_source_url IS NOT NULL)))",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_official_source_url_check",
        "definition": "CHECK ((official_source_url ~* '^https?://[^/[:space:]]+'::text))",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_pkey",
        "definition": "PRIMARY KEY (id)",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_provenance_check",
        "definition": "CHECK ((provenance = ANY (ARRAY['official'::text, 'legendstudy_derived'::text, 'ai_generated'::text])))",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_question_count_check",
        "definition": "CHECK ((question_count > 0))",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_session_label_check",
        "definition": "CHECK (((session_label IS NULL) OR (btrim(session_label) <> ''::text)))",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_university_id_fkey",
        "definition": "FOREIGN KEY (university_id) REFERENCES universities(id) ON DELETE RESTRICT",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_verification",
        "definition": "CHECK ((((verification_status = 'review'::text) AND (verified_at IS NULL) AND (NOT is_active)) OR ((verification_status = 'verified'::text) AND (verified_at IS NOT NULL) AND (provenance IS NOT NULL) AND (NULLIF(btrim(evidence_note), ''::text) IS NOT NULL) AND ((metadata_resource_id IS NOT NULL) OR (official_source_url IS NOT NULL)))))",
        "relation": "essay_exams"
      },
      {
        "conname": "essay_exams_verification_status_check",
        "definition": "CHECK ((verification_status = ANY (ARRAY['review'::text, 'verified'::text])))",
        "relation": "essay_exams"
      },
      {
        "conname": "profiles_academic_status_check",
        "definition": "CHECK ((academic_status = ANY (ARRAY['student'::text, 'retaker'::text, 'other'::text])))",
        "relation": "profiles"
      },
      {
        "conname": "profiles_display_name_check",
        "definition": "CHECK (((display_name IS NULL) OR ((char_length(btrim(display_name)) >= 1) AND (char_length(btrim(display_name)) <= 80))))",
        "relation": "profiles"
      },
      {
        "conname": "profiles_grade_level_check",
        "definition": "CHECK ((grade_level = ANY (ARRAY[1, 2, 3])))",
        "relation": "profiles"
      },
      {
        "conname": "profiles_id_fkey",
        "definition": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE",
        "relation": "profiles"
      },
      {
        "conname": "profiles_neis_school_pair",
        "definition": "CHECK ((((neis_office_code IS NULL) = (neis_school_code IS NULL)) AND ((neis_office_code IS NULL) OR ((neis_office_code = btrim(neis_office_code, ' \t\n\r\f\u000b'::text)) AND ((char_length(neis_office_code) >= 1) AND (char_length(neis_office_code) <= 32)))) AND ((neis_school_code IS NULL) OR ((neis_school_code = btrim(neis_school_code, ' \t\n\r\f\u000b'::text)) AND ((char_length(neis_school_code) >= 1) AND (char_length(neis_school_code) <= 32))))))",
        "relation": "profiles"
      },
      {
        "conname": "profiles_pkey",
        "definition": "PRIMARY KEY (id)",
        "relation": "profiles"
      },
      {
        "conname": "profiles_target_pair",
        "definition": "CHECK ((((target_date IS NULL) = (target_label IS NULL)) AND ((target_date IS NULL) OR isfinite(target_date)) AND ((target_label IS NULL) OR ((target_label = btrim(target_label, ' \t\n\r\f\u000b'::text)) AND ((char_length(target_label) >= 1) AND (char_length(target_label) <= 80))))))",
        "relation": "profiles"
      }
