      {
        "definition": "CHECK ((((neis_office_code IS NULL) = (neis_school_code IS NULL)) AND ((neis_office_code IS NULL) OR ((neis_office_code = btrim(neis_office_code, ' \t\n\r\f\u000b'::text)) AND ((char_length(neis_office_code) >= 1) AND (char_length(neis_office_code) <= 32)))) AND ((neis_school_code IS NULL) OR ((neis_school_code = btrim(neis_school_code, ' \t\n\r\f\u000b'::text)) AND ((char_length(neis_school_code) >= 1) AND (char_length(neis_school_code) <= 32))))))",
