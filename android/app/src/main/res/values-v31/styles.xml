<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API31+) system SplashScreen: white background + the LegendStudy
     launcher symbol, centred and system-masked. Kept minimal — product name and
     tagline are drawn by the Flutter cold-start brand frame, not the native
     splash. postSplashScreenTheme hands off to the normal window theme. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_brand_symbol</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
